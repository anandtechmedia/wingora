# Wingora backend, Production environment on AWS. Template only: deploy/server/provision.sh writes the real file to
# /srv/wingora/production/shared/.env with generated keys and passwords. Never commit real values.
# 203-0-113-10 stands for the server's static IP (dashes); provision.sh fills it in.
APP_NAME=Wingora
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://app.203-0-113-10.sslip.io
FRONTEND_URL=https://app.203-0-113-10.sslip.io

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
SECURITY_LOG_DAYS=90
# Audit hash-chain key: a long random value per environment, backed up with APP_KEY. Empty falls back to one derived from APP_KEY.
AUDIT_HMAC_KEY=

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=wingora_production
DB_USERNAME=wingora_production
DB_PASSWORD=

# Sessions: encrypted, Secure, HttpOnly, SameSite=Lax. Set SESSION_SECURE_COOKIE=false only for plain-HTTP local dev.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ABSOLUTE_LIFETIME=720
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_EXPIRE_ON_CLOSE=true
SESSION_PATH=/
SESSION_DOMAIN=null

# First-party SPA origins (cookie auth) and browser origins allowed by CORS. "*" is ignored.
SANCTUM_STATEFUL_DOMAINS=app.203-0-113-10.sslip.io
CORS_ALLOWED_ORIGINS=https://app.203-0-113-10.sslip.io

# Bearer tokens: absolute ceiling (SANCTUM_EXPIRATION) and default lifetime for new tokens, in minutes.
SANCTUM_EXPIRATION=43200
SANCTUM_TOKEN_PREFIX=wgr_
API_TOKEN_TTL_MINUTES=10080
API_TOKEN_MAX_PER_USER=10

LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
MFA_ISSUER=Wingora

# Comma-separated proxy IPs/CIDRs in front of the app. Never "*" unless only reachable via the proxy.
TRUSTED_PROXIES=
# Comma-separated host regexes accepted in the Host header (staging/production).
TRUSTED_HOSTS=^app\.203-0-113-10\.sslip\.io$

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=redis

# Private document storage: local disk or S3-compatible bucket (private ACL).
SECURE_FILES_DRIVER=local
SECURE_FILES_MAX_KB=10240
SECURE_FILES_KEY=
SECURE_FILES_SECRET=
SECURE_FILES_REGION=
SECURE_FILES_BUCKET=
SECURE_FILES_ENDPOINT=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_USERNAME=wingora_production
REDIS_PASSWORD=
REDIS_PREFIX=wingora-production:
REDIS_DB=4
REDIS_CACHE_DB=5
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@app.203-0-113-10.sslip.io"
MAIL_FROM_NAME="${APP_NAME}"

# Optional AI provider for advisory features (none | openai_compatible). Keys belong in the environment, never in git.
AI_PROVIDER=none
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Billing. Leave the Stripe keys empty to run without online payments (trials and manually managed plans only).
BILLING_TRIAL_PLAN=growth
BILLING_GRACE_DAYS=7
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
